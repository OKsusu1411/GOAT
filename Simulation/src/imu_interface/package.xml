<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imu_interface</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="hansusu1411@gmail.com">oksusu</maintainer>
  <license>TODO: License declaration</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Provides rosidl_generate_interfaces() and the code generators it dispatches -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Message packages referenced by ImuState.msg; needed to build and to run -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Runtime support for the generated interface code (typesupport libs, etc.) -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Marks this package as a producer of ROS interfaces (required by rosidl_generate_interfaces) -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

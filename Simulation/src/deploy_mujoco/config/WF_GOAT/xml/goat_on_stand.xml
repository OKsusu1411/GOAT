<mujoco model="GOAT_on_Stand">
    <compiler angle="radian" coordinate="local" meshdir="../meshes/"/>
    <option timestep="0.005" gravity="0 0 -9.81"/>

    <!-- GOAT robot -->
    <include file="./goat_floating.xml"/>

    <!-- Stand jig -->
    <asset>
        <mesh name="jig_mesh" file="GOAT_stand7mm35cm.stl" scale="0.5 1 1"/>
        <material name="jig_material" rgba="0.8 0.8 0.8 1.0"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

        <body name="jig_link" pos="-0.04 0 0">
            <inertial pos="0 0 0" mass="10.0" fullinertia="0.05 0.05 0.05 0.0 0.0 0.0"/>
            <geom name="jig_geom" type="mesh" mesh="jig_mesh" material="jig_material"
                  pos="0 0 0" euler="0 0 -1.570796"
                  contype="1" conaffinity="1"/>
        </body>
    </worldbody>
</mujoco>

<mujoco model="WF_GOAT">
    <compiler angle="radian" coordinate="local" meshdir="../meshes/" autolimits="true"/>

    <asset>
        <mesh name="base_Link" file="base_Link_simple.stl"/>
        <mesh name="hip_L_Link" file="hip_L_Link.stl"/>
        <mesh name="hip_R_Link" file="hip_R_Link.stl"/>
        <mesh name="thigh_L_Link" file="thigh_L_Link.stl"/>
        <mesh name="thigh_R_Link" file="thigh_R_Link.stl"/>
        <mesh name="calf_L_Link" file="calf_L_Link.stl"/>
        <mesh name="calf_R_Link" file="calf_R_Link.stl"/>
        <mesh name="wheel_L_Link" file="BF_wheel_L_Link.stl"/>
        <mesh name="wheel_R_Link" file="BF_wheel_R_Link.stl"/>
        
        <material name="orange" rgba="1.0 0.423 0.039 1.0"/>
        <material name="black" rgba="0.792 0.819 0.933 1.0"/>
        <material name="white" rgba="1.0 1.0 1.0 1.0"/>
    </asset>

    <default>
        <geom contype="1" conaffinity="1" friction="0.6 0.1 0.1"/>
        <motor ctrllimited="true"/>
    </default>

    <!-- GOAT -->
    <worldbody>
        <body name="base_Link" pos="0 0 1.0">
            <!-- Floating base -->
            <freejoint name="root"/>
            <site name="imu_site" pos="0 0 0" size="0.01" type="sphere" rgba="1 0 0 1"/>
            
            <inertial pos="0 0 0" mass="3.153308" fullinertia="0.021860000 0.025170000 0.023520000 -0.000011699458 0.006702000 0.000004493943"/>
            <geom type="mesh" mesh="base_Link" material="black" pos="-0.112941 0 0.084350" contype="0" conaffinity="0" group="1"/>
            <geom type="box" size="0.107 0.100 0.095" pos="-0.011 0 0.056" group="3"/>
            <geom type="box" size="0.035 0.125 0.040" pos="0.07 0 -0.078" group="3"/>

            <body name="hip_L_Link" pos="0.049579 0.096336 -0.087088">
                <joint name="hip_L_Joint" type="hinge" axis="-1 0 0" range="-1.7453 1.0123" damping="0.05" frictionloss="0.04" armature="0.00"/>
                <inertial pos="-0.0475 -0.038265 0.000247" mass="0.326" fullinertia="0.000153800 0.000232600 0.000209300 -0.00001384168 -0.000007365016 -0.000000923815"/>
                <geom type="mesh" mesh="hip_L_Link" material="black" contype="0" conaffinity="0" group="1"/>
                <geom type="cylinder" size="0.042 0.0675" pos="-0.0535 0 0" euler="1.57 0 0" group="3"/>

                <body name="thigh_L_Link" pos="-0.054 -0.017 0">
                    <joint name="thigh_L_Joint" type="hinge" axis="0 1 0" range="-0.3840 2.0071" damping="0.08" frictionloss="0.15" armature="0.00"/>
                    <inertial pos="-0.002015 0.042352 -0.035272" mass="0.483216" fullinertia="0.002425000 0.002342000 0.000385000 -0.000020797926 -0.000075779875 -0.000378300"/>
                    <geom type="mesh" mesh="thigh_L_Link" material="white" contype="0" conaffinity="0" group="1"/>
                    <geom type="box" size="0.045 0.025 0.0725" pos="-0.011 0.016 -0.116" group="3"/>

                    <body name="calf_L_Link" pos="0 0.018 -0.205">
                        <joint name="knee_L_Joint" type="hinge" axis="0 -1 0" range="-0.523599 2.3387" damping="0.15" frictionloss="0.25" armature="0.008"/>
                        <inertial pos="0.001969 0.000712 -0.160161" mass="0.303" fullinertia="0.001598000 0.001638000 0.000095365219 0.000000705710 -0.000031199137 0.000006440235"/>
                        <geom type="mesh" mesh="calf_L_Link" material="black" contype="0" conaffinity="0" group="1"/>
                        <geom type="cylinder" size="0.0325 0.1165" pos="0 0 -0.116" group="3"/>

                        <body name="wheel_L_Link" pos="0 0.016555 -0.200">
                            <joint name="wheel_L_Joint" type="hinge" axis="0 1 0" damping="0.002" frictionloss="0.02" armature="0.00"/>
                            <inertial pos="0 0.030660 0" mass="0.985" fullinertia="0.003366000 0.006306000 0.003366000 0 0 0"/>
                            <geom type="mesh" mesh="wheel_L_Link" material="orange" contype="0" conaffinity="0" group="1"/>
                            <geom name="wheel_L_collision" type="cylinder" size="0.1 0.025" pos="0 0.03 0" euler="1.5707963267948966 0 0" group="3"/>
                        </body>
                    </body>
                </body>
            </body>

            <body name="hip_R_Link" pos="0.049579 -0.096336 -0.087088">
                <joint name="hip_R_Joint" type="hinge" axis="-1 0 0" range="-1.0123 1.7453" damping="0.05" frictionloss="0.04" armature="0.00"/>
                <inertial pos="-0.0475 0.038265 0.000247" mass="0.326" fullinertia="0.000153800 0.000232600 0.000209300 0.00001384168 -0.000007365016 0.000000923815"/>
                <geom type="mesh" mesh="hip_R_Link" material="black" contype="0" conaffinity="0" group="1"/>
                <geom type="cylinder" size="0.042 0.0675" pos="-0.0535 0 0" euler="1.57 0 0" group="3"/>

                <body name="thigh_R_Link" pos="-0.054 0.017 0">
                    <joint name="thigh_R_Joint" type="hinge" axis="0 -1 0" range="-2.0071 0.3840" damping="0.08" frictionloss="0.15" armature="0.00"/>
                    <inertial pos="-0.002015 -0.042352 -0.035272" mass="0.483216" fullinertia="0.002425000 0.002342000 0.000385000 0.000020797926 -0.000075779875 0.000378300"/>
                    <geom type="mesh" mesh="thigh_R_Link" material="white" contype="0" conaffinity="0" group="1"/>
                    <geom type="box" size="0.045 0.025 0.0725" pos="-0.011 -0.016 -0.116" group="3"/>

                    <body name="calf_R_Link" pos="0 -0.018 -0.205">
                        <joint name="knee_R_Joint" type="hinge" axis="0 1 0" range="-2.3387 0.523599" damping="0.15" frictionloss="0.25" armature="0.008"/>
                        <inertial pos="0.001969 -0.000712 -0.160161" mass="0.303" fullinertia="0.001598000 0.001638000 0.000095365219 -0.000000705710 -0.000031199137 -0.000006440235"/>
                        <geom type="mesh" mesh="calf_R_Link" material="black" contype="0" conaffinity="0" group="1"/>
                        <geom type="cylinder" size="0.0325 0.1165" pos="0 0 -0.116" group="3"/>

                        <body name="wheel_R_Link" pos="0 -0.016555 -0.200">
                            <joint name="wheel_R_Joint" type="hinge" axis="0 -1 0" damping="0.002" frictionloss="0.02" armature="0.00"/>
                            <inertial pos="0 -0.030660 0" mass="0.985" fullinertia="0.003366000 0.006306000 0.003366000 0 0 0"/>
                            <geom type="mesh" mesh="wheel_R_Link" material="orange" contype="0" conaffinity="0" group="1"/>
                            <geom name="wheel_R_collision" type="cylinder" size="0.1 0.025" pos="0 -0.03 0" euler="1.5707963267948966 0 0" group="3"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- Joint actuator -->
    <actuator>
        <!-- 0.005s (200Hz) write delay -->
        <motor name="hip_L_Joint"   joint="hip_L_Joint"   ctrllimited="true" ctrlrange="-4.5 4.5" forcelimited="true" forcerange="-4.5 4.5" nsample="5" delay="0.005"/>
        <motor name="thigh_L_Joint" joint="thigh_L_Joint" ctrllimited="true" ctrlrange="-4.5 4.5" forcelimited="true" forcerange="-4.5 4.5" nsample="5" delay="0.005"/>
        <motor name="knee_L_Joint"  joint="knee_L_Joint"  ctrllimited="true" ctrlrange="-9.0 9.0" forcelimited="true" forcerange="-9.0 9.0" nsample="5" delay="0.005"/>
        <motor name="wheel_L_Joint" joint="wheel_L_Joint" ctrllimited="true" ctrlrange="-2.5 2.5" forcelimited="true" forcerange="-2.5 2.5" nsample="5" delay="0.005"/>
        <motor name="hip_R_Joint"   joint="hip_R_Joint"   ctrllimited="true" ctrlrange="-4.5 4.5" forcelimited="true" forcerange="-4.5 4.5" nsample="5" delay="0.005"/>
        <motor name="thigh_R_Joint" joint="thigh_R_Joint" ctrllimited="true" ctrlrange="-4.5 4.5" forcelimited="true" forcerange="-4.5 4.5" nsample="5" delay="0.005"/>
        <motor name="knee_R_Joint"  joint="knee_R_Joint"  ctrllimited="true" ctrlrange="-9.0 9.0" forcelimited="true" forcerange="-9.0 9.0" nsample="5" delay="0.005"/>
        <motor name="wheel_R_Joint" joint="wheel_R_Joint" ctrllimited="true" ctrlrange="-2.5 2.5" forcelimited="true" forcerange="-2.5 2.5" nsample="5" delay="0.005"/>
    </actuator>
    
    <!-- Sensor (noise isn't applied automatically) -->
    <sensor>
        <!-- IMU -->
        <!-- 0.005s (200Hz) read delay -->
        <framequat name="imu_quat" objtype="site" objname="imu_site" noise="0.01"/>
        <gyro name="imu_gyro" site="imu_site" noise="0.01" nsample="5" delay="0.005"/>

        <!-- Motor encoder -->
        <!-- 0.003s read delay -->
        <jointpos name="hip_L_Joint_pos" joint="hip_L_Joint" nsample="5" delay="0.003"/>
        <jointpos name="thigh_L_Joint_pos" joint="thigh_L_Joint" nsample="5" delay="0.003"/>
        <jointpos name="knee_L_Joint_pos" joint="knee_L_Joint" nsample="5" delay="0.003"/>
        <jointpos name="wheel_L_Joint_pos" joint="wheel_L_Joint" nsample="5" delay="0.003"/>
        <jointpos name="hip_R_Joint_pos" joint="hip_R_Joint" nsample="5" delay="0.003"/>
        <jointpos name="thigh_R_Joint_pos" joint="thigh_R_Joint" nsample="5" delay="0.003"/>
        <jointpos name="knee_R_Joint_pos" joint="knee_R_Joint" nsample="5" delay="0.003"/>
        <jointpos name="wheel_R_Joint_pos" joint="wheel_R_Joint" nsample="5" delay="0.003"/>

        <jointvel name="hip_L_Joint_vel" joint="hip_L_Joint" nsample="5" delay="0.003"/>
        <jointvel name="thigh_L_Joint_vel" joint="thigh_L_Joint" nsample="5" delay="0.003"/>
        <jointvel name="knee_L_Joint_vel" joint="knee_L_Joint" nsample="5" delay="0.003"/>
        <jointvel name="wheel_L_Joint_vel" joint="wheel_L_Joint" nsample="5" delay="0.003"/>
        <jointvel name="hip_R_Joint_vel" joint="hip_R_Joint" nsample="5" delay="0.003"/>
        <jointvel name="thigh_R_Joint_vel" joint="thigh_R_Joint" nsample="5" delay="0.003"/>
        <jointvel name="knee_R_Joint_vel" joint="knee_R_Joint" nsample="5" delay="0.003"/>
        <jointvel name="wheel_R_Joint_vel" joint="wheel_R_Joint" nsample="5" delay="0.003"/>

        <jointactuatorfrc name="hip_L_Joint_torque" joint="hip_L_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="thigh_L_Joint_torque" joint="thigh_L_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="knee_L_Joint_torque" joint="knee_L_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="wheel_L_Joint_torque" joint="wheel_L_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="hip_R_Joint_torque" joint="hip_R_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="thigh_R_Joint_torque" joint="thigh_R_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="knee_R_Joint_torque" joint="knee_R_Joint" nsample="5" delay="0.003"/>
        <jointactuatorfrc name="wheel_R_Joint_torque" joint="wheel_R_Joint" nsample="5" delay="0.003"/>
    </sensor>

    <!-- Turn off self collision -->

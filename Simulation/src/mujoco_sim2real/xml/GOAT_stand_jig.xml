<mujoco model="Stand_jig">
    <compiler angle="radian" coordinate="local"/>

    <asset>
        <mesh name="jig_mesh" file="../meshes/GOAT_gochu_stand7mm35cm.stl" scale="0.5 1 1"/>
        <material name="jig_material" rgba="0.8 0.8 0.8 1.0"/>

        <!-- Procedural checker texture for the ground plane (gives depth/motion cues). -->
        <texture name="floor_checker" type="2d" builtin="checker"
                 rgb1="0.25 0.28 0.32" rgb2="0.35 0.40 0.45"
                 width="512" height="512"/>
        <!-- Material wrapping the checker; texrepeat sets tile density, reflectance adds subtle shading. -->
        <material name="floor_material" texture="floor_checker"
                  texrepeat="5 5" texuniform="true" reflectance="0.1"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <!-- Ground plane: checker material instead of solid color for visual depth. -->
        <geom name="floor" type="plane" size="0 0 1" material="floor_material"/>

        <body name="jig_link" pos="0 0 0">
            <inertial pos="0 0 0" mass="10.0" fullinertia="0.05 0.05 0.05 0.0 0.0 0.0"/>

            <geom name="jig_geom" type="mesh" mesh="jig_mesh" material="jig_material"
                  pos="0 0 0" euler="0 0 -1.570796"
                  contype="1" conaffinity="1"/>
        </body>
    </worldbody>
</mujoco>